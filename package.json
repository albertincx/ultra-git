{
  "name": "ultra-git",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mac": "swiftc -O macos/main.swift -o macos/ultraGit",
    "build:app": "swiftc -O macos/main.swift -o macos/ultraGit && mkdir -p 'macos/ultra Git.app/Contents/MacOS' 'macos/ultra Git.app/Contents/Resources' && cp macos/ultraGit 'macos/ultra Git.app/Contents/MacOS/' && cp macos/AppIcon.icns 'macos/ultra Git.app/Contents/Resources/' && cp macos/Info.plist 'macos/ultra Git.app/Contents/'",
    "build:all": "pnpm run build && pnpm run build:app",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js & vite"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@monaco-editor/react": "^4.7.0",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.64.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
